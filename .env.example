NODE_ENV=production
PORT=2711

DATABASE_URL=postgresql://ravaa:ravaa_dev_password@db:5432/ravaa_service

JWT_SECRET=change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=change-this-production-refresh-min-32-chars

# Admin bootstrap (development only)
# Jika kosong, seed akan pakai default: admin@ravaa.my.id / Secret123
INITIAL_ADMIN_EMAIL=admin@ravaa.my.id
INITIAL_ADMIN_PASSWORD=Secret123
INITIAL_ADMIN_USERNAME=admin
# Seed demo data (set false untuk skip)
SEED_DEMO_USER=true
SEED_SAMPLE_APPS=true

# Email
EMAIL_ENABLED=false
EMAIL_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=no-reply@ravaa.my.id
MAIL_FROM_NAME=Ravaa Account
ACCOUNT_WEB_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_HOURS=24
