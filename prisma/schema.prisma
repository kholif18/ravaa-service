generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  active
  suspended
  pending
}

enum ApplicationStatus {
  active
  inactive
  suspended
  disabled
}

enum PrincipalType {
  USER
  APPLICATION
  SYSTEM
}

enum PermissionEffect {
  allow
  deny
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique
  username        String      @unique
  passwordHash    String      @map("password_hash")
  displayName     String?     @map("display_name")
  avatarUrl       String?     @map("avatar_url")
  role            UserRole    @default(USER)
  status          UserStatus  @default(active)
  emailVerifiedAt DateTime?   @map("email_verified_at")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil     DateTime?   @map("locked_until")
  recoveryEmail   String?     @map("recovery_email")
  recoveryPhone   String?     @map("recovery_phone")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret String?     @map("two_factor_secret")
  twoFactorBackupCodes String[] @default([]) @map("two_factor_backup_codes")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sessions                    Session[]
  userApplicationAccess       UserApplicationAccess[]
  passwordResets              PasswordReset[]
  emailVerifications          EmailVerification[]
  auditLogs                   AuditLog[]

  @@map("users")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  refreshTokenHash String  @map("refresh_token_hash")
  deviceName      String?   @map("device_name")
  deviceType      String?   @map("device_type")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  lastActiveAt    DateTime? @map("last_active_at")
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

// ─── Application ──────────────────────────────────────────────────────────────

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  clientId         String            @unique @map("client_id")
  clientSecretHash String            @map("client_secret_hash")
  redirectUris     String[]          @default([]) @map("redirect_uris")
  status           ApplicationStatus @default(active)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  applicationScopes       ApplicationScope[]
  userApplicationAccess   UserApplicationAccess[]
  auditLogs               AuditLog[]

  @@map("applications")
}

// ─── ApplicationScope ─────────────────────────────────────────────────────────

model ApplicationScope {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  scope         String
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, scope])
  @@map("application_scopes")
}

// ─── UserApplicationAccess ────────────────────────────────────────────────────

model UserApplicationAccess {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  scopes        String[]
  grantedAt     DateTime @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@map("user_application_access")
}

// ─── PasswordReset ────────────────────────────────────────────────────────────

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_resets")
}

// ─── EmailVerification ────────────────────────────────────────────────────────

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verifications")
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  action        String
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Permission ───────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  resourcePermissions ResourcePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@map("permissions")
}

// ─── ResourcePermission ──────────────────────────────────────────────────────

model ResourcePermission {
  id             String         @id @default(uuid()) @db.Uuid
  resourceType   String         @map("resource_type")
  resourceId     String         @map("resource_id")
  principalType  PrincipalType  @map("principal_type")
  principalId    String         @map("principal_id")
  permissionId   String         @map("permission_id") @db.Uuid
  effect         PermissionEffect @default(allow)
  grantedAt      DateTime       @default(now()) @map("granted_at")
  revokedAt      DateTime?      @map("revoked_at")
  expiresAt      DateTime?      @map("expires_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, principalType, principalId, permissionId])
  @@index([resourceType, resourceId])
  @@index([principalType, principalId])
  @@index([permissionId])
  @@map("resource_permissions")
}
